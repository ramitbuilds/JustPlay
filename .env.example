# Server only. Add these in Vercel Production, then redeploy. Never use VITE_ keys.
AI_PROVIDER=gemma
GEMINI_API_KEY=
GEMMA_MODEL=gemma-4-26b-a4b-it
# Create a key at https://aistudio.google.com/apikey in an eligible free-tier project.
# Gemma is the default even if a stale Groq key exists. No Groq key is needed.
# Vercel supplies its own per-instance limiter; no AI_RATE_LIMITER env var is needed.
# Cloudflare uses the native rate-limit binding declared in wrangler.jsonc.
