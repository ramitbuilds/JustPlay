# Server bindings only. Vite never needs these. Never prefix keys with VITE_.
AI_PROVIDER=gemma
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMMA_MODEL=gemma-4-26b-a4b-it
# Vercel: set these as server-side Production variables, then redeploy.
# With one key, Vercel can infer the provider. Select AI_PROVIDER when both exist.
# Cloudflare only: AI_RATE_LIMITER is a native binding in wrangler.jsonc.
# Vercel supplies a bounded per-instance limiter; no Cloudflare binding is needed.
